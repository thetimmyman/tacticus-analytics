root = n18
n1 = StudyHeading("Layout family", "Search and filters", "What stays visible on a phone, what may collapse, and how an active filter stays obvious when it is closed.")
n2 = StudyTable(["Control", "Placement", "Behaviour"], [["Search", "Always visible", "Full width, its own row, never behind an icon"], ["Primary filters", "Always visible", "The two or three that carry most decisions"], ["Secondary filters", "Behind one expand control", "Closed state must show how many are active"], ["Reset", "Visible whenever anything is active", "Clears every filter, including the collapsed ones"], ["Result count", "Above the results", "States what the count covers and what it excludes"]])
n3 = StudyNote("Chosen option. Search and the primary filters never hide, so the common path costs no extra taps. Secondary filters may collapse, but the closed control must reveal that filters remain active and offer a clear reset.")
n4 = StudyPanel("Option A - always-on search, collapsible secondary", "Search and primary filters visible; secondary behind one control.", "Chosen", [n2, n3])
n5 = StudyTable(["Control", "Behaviour"], [["Everything", "Behind one filter button showing a count"], ["Search", "Revealed with the filters"], ["Reset", "Inside the panel"]])
n6 = StudyNote("Rejected option. It is the slimmest header, but a phone user cannot see what is filtering the list, and an active filter that changes every number on screen is invisible.")
n7 = StudyPanel("Option B - everything collapsed", "The current behaviour on some pages, kept for comparison.", "Rejected", [n5, n6])
n8 = StudyTable(["Concern", "Rule"], [["Targets", "Every filter control keeps a full-height touch target"], ["Keyboard", "Expand, each filter, and reset are reachable in visual order"], ["Active state", "Shown by label and count, not colour alone"], ["Depth", "Filters do not move the results below the fold on first paint"], ["Persistence", "An applied filter survives navigation back to the page where the native store owns it"]])
n9 = StudyNote("Shared by every page in this family.")
n10 = StudyPanel("Shared rules", "Applies to both options.", "Shared", [n8, n9])
n11 = StudyTable(["State", "Behaviour"], [["Reading", "Filters stay usable; results show a named skeleton"], ["No matches", "Says which filters produced the empty result and offers reset"], ["Empty without filters", "Says what an empty collection means here"], ["Unavailable", "Names the source that could not be read; filters stay visible but are marked inert"]])
n12 = StudyNote("An empty result under an active filter is not the same claim as an empty collection.")
n13 = StudyPanel("States", "Filter behaviour while results resolve.", "Shared", [n11, n12])
n14 = StudyTable(["Check", "Result"], [["Search", "Visible and usable without opening anything"], ["Active filter", "Count and label visible while closed"], ["Reset", "Clears collapsed filters too, and the results follow"], ["Focus order", "Search, primary filters, expand, reset, results"], ["Dark theme", "Active state readable without colour alone"], ["Reduced motion", "Panel opens without animation"]])
n15 = StudyNote("Native verification checklist for this family. Results are recorded separately from this study.")
n16 = StudyDetails("Native checks", "What must be inspected in the built app, not in this artifact.", [n14, n15])
n17 = Stack([n1, n4, n7, n10, n13, n16])
n18 = Stack([n17])

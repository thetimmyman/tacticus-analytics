root = n20
n1 = StudyHeading("Layout family", "Detail pages", "What a single subject - one entry, one record, one item - shows first on a phone, and what waits behind a disclosure.")
n2 = StudyTable(["Part", "Rule", "Authority"], [["Title", "Complete, on its own line, at the top", "Page owner"], ["Decision line", "The next action or the active work, above the fold", "Page owner"], ["Key figures", "Two per row, the ones a decision uses", "Shared metric primitive"], ["Primary action", "Sticky bottom bar, clear target, deliberate confirmation where destructive", "Shared action bar"], ["Sections", "Stacked in reading order, one column", "Page owner"], ["Provenance", "Behind a labelled disclosure", "Page owner"]])
n3 = StudyNote("Chosen option. The phone detail page keeps the decision at the top and pushes history and provenance down or behind a disclosure, without shortening a title to make a header fit.")
n4 = StudyPanel("Option A - decision first", "Title, decision, key figures, then supporting sections.", "Chosen", [n2, n3])
n5 = StudyTable(["Part", "Rule", "Authority"], [["Header", "Full-width banner with image and description", "Page owner"], ["Figures", "Four across, small type", "Shared metric primitive"], ["Sections", "Two columns, collapsed by default", "Page owner"], ["Actions", "Inline at the end of the page", "Page owner"]])
n6 = StudyNote("Rejected option. It is the desktop detail page narrowed. On a phone it puts a tall decorative block above the fold and hides every section behind a tap.")
n7 = StudyPanel("Option B - desktop narrowed", "The current behaviour, kept for comparison.", "Rejected", [n5, n6])
n8 = StudyTable(["Concern", "Rule"], [["Sticky bar", "Sits above the bottom safe area and does not cover the last section"], ["Charts", "Full width, fixed readable height, values readable without a hover-only tooltip"], ["Long values", "Wrap or break; an identifier may shorten if the full value is in a disclosure"], ["Tabs", "Scroll horizontally with the selected tab visible; never wrap to a second row"], ["Back path", "One control near the title; browser back still works"]])
n9 = StudyNote("Shared by every detail page in the family.")
n10 = StudyPanel("Shared rules", "Applies to both options.", "Shared", [n8, n9])
n11 = StudyTable(["State", "What the page says"], [["Reading", "Which part is still loading, and what is already known"], ["Empty", "Nothing recorded yet, and what would create the first entry"], ["Partial", "Which sections were read and which were not"], ["Stale", "Last read time, kept next to the figures it affects"], ["Unavailable", "Which source failed; figures show as unknown, not zero"], ["Observed zero", "A real zero, distinct from an absent observation"]])
n12 = StudyNote("A detail page never presents an unread value as a measured one.")
n13 = StudyPanel("States", "Every detail page must render all six.", "Shared", [n11, n12])
n14 = StudyTable(["Check", "Result"], [["Complete title", "Wraps, never clipped"], ["Above the fold", "Title, decision and key figures visible without scrolling"], ["Sticky bar", "Clears the safe area and the last section"], ["Keyboard", "Tabs, disclosures and the action bar reachable in visual order"], ["Dark theme", "Same hierarchy without colour alone"], ["Reduced motion", "Content appears without animation"]])
n15 = StudyNote("Native verification checklist for this family. Results are recorded separately from this study.")
n16 = StudyDetails("Native checks", "What must be inspected in the built app, not in this artifact.", [n14, n15])
n17 = StudyTable(["Family", "Study", "Status"], [["Phone shell", "mobile-shell", "Chosen"], ["Report and list pages", "mobile-report-list", "Chosen"], ["Detail pages", "This study", "Chosen"], ["Search and filters", "mobile-filter-bar", "Chosen"], ["States", "mobile-states", "Chosen"]])
n18 = StudyNote("Sibling studies in this family set.")
n19 = StudyDetails("Family set", "The other phone studies, and their current standing.", [n17, n18])
n20 = Stack([n1, n4, n7, n10, n13, n16, n19])

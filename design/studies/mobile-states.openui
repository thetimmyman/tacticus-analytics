root = n16
n1 = StudyHeading("Layout family", "States on a phone", "The six states every page must render, and the line between an absent observation and an observed zero.")
n2 = StudyTable(["State", "What the user sees", "What it must not say"], [["Reading", "A named skeleton in the shape of the real content, plus what is already known", "A number with no source"], ["Empty", "Nothing here, what that means, and what would fill it", "A bare icon"], ["Partial", "What was read, what was not, and which figures are affected", "A full total"], ["Stale", "The last values with the time they were read", "An undated figure"], ["Unavailable", "The source that could not be read, and what is still known", "Zero"], ["Observed zero", "A real zero, with its source and time", "Anything vaguer than a measurement"]])
n3 = StudyNote("The distinction the design must keep: an absent observation is not an observed zero, and a reachable endpoint is not a healthy session. A successful read of one source does not make an estimate a fact.")
n4 = StudyPanel("The six states", "Shared across every page family.", "Shared", [n2, n3])
n5 = StudyTable(["Rule", "Behaviour"], [["Colour", "State is readable without colour alone; label or shape carries it"], ["Focus", "State controls and disclosures are keyboard reachable in visual order"], ["Motion", "Reduced motion removes animation without removing information"], ["Density", "A state block stays compact; it does not fill the screen with an illustration"], ["Action", "Where a user can act, the action is present; where they cannot, none is offered"]])
n6 = StudyNote("These are the shared checks. Each page family adds its own.")
n7 = StudyPanel("Shared checks", "Applies to every state in every family.", "Shared", [n5, n6])
n8 = StudyTable(["Family", "Study", "Status"], [["Phone shell", "mobile-shell", "Chosen"], ["Report and list pages", "mobile-report-list", "Chosen"], ["Detail pages", "mobile-detail", "Chosen"], ["Search and filters", "mobile-filter-bar", "Chosen"], ["States", "This study", "Chosen"]])
n9 = StudyNote("This family set covers the pages behind it. A page that fits an existing family reuses it; only a genuinely new shape needs a new study.")
n10 = StudyPanel("Family set", "The five phone studies.", "Set", [n8, n9])
n11 = StudyTable(["Width", "Purpose"], [["Smallest supported phone", "Primary check"], ["Common phone", "Primary check"], ["Large phone", "Primary check"], ["Tablet portrait", "Confirm the family degrades as designed"]])
n12 = StudyNote("Use the product's supported widths and real target dimensions. Desktop breakpoints are not imposed on a phone. Both supported themes are checked.")
n13 = StudyPanel("Verification widths", "Where the native result is inspected.", "Native", [n11, n12])
n14 = StudyNote("Synthetic design values. No live source, action or confirmation is connected. Native captures and behaviour checks are recorded separately from this artifact.")
n15 = StudyShell("states", [n1, n4, n7, n10, n13, n14])
n16 = Stack([n15])

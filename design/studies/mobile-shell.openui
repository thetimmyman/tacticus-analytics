root = n20
n1 = StudyHeading("Layout family", "Phone shell", "Choose the phone chrome: what is always reachable, what opens on demand, and how the safe area is respected.")
n2 = StudyTable(["Control", "Placement", "Authority", "Notes"], [["Primary destinations", "Bottom bar, 5 max", "Native navigation config", "Reachable without opening anything; complete labels, no icons alone"], ["Season selector", "Top bar", "Native session state", "Applies to every page below the shell"], ["Everything else", "Top bar menu", "Native navigation config", "Same source of truth as the bottom bar; never a second list"], ["Account", "Top bar menu", "Native session state", "Sign out stays behind a confirmation"], ["Content area", "Below top bar, above bottom bar", "Page owner", "Full viewport height minus both bars and the safe area"]])
n3 = StudyNote("Chosen option. The bottom bar carries the destinations a visit usually starts from; the menu carries the rest. Both read one navigation source, so a page can never appear in only one of them.")
n4 = StudyPanel("Option A - bottom bar plus menu", "Five destinations always visible, the rest one tap away.", "Chosen", [n2, n3])
n5 = StudyTable(["Control", "Placement", "Authority", "Notes"], [["Everything", "Top bar menu", "Native navigation config", "Every destination is behind a menu open"], ["Season selector", "Top bar", "Native session state", "Shares the row with the menu trigger"], ["Content area", "Below top bar", "Page owner", "Full viewport height minus the safe area"]])
n6 = StudyNote("Rejected option. It is the current arrangement. It keeps the header small, but the most used destinations cost two taps each and nothing shows which section you are in.")
n7 = StudyPanel("Option B - menu only", "The current arrangement, kept for comparison.", "Rejected", [n5, n6])
n8 = StudyTable(["Rule", "Behaviour"], [["Safe area", "Both bars add top and bottom inset padding; content never sits under a notch or home indicator"], ["Viewport unit", "Dynamic viewport height, so browser chrome does not clip the last row"], ["Type", "Body stays at the readable base size; padding reduces before type does"], ["Targets", "Every control in the shell keeps a full-height touch target"], ["Focus", "Bottom bar and menu are keyboard reachable in visual order, with a visible focus ring"], ["Reduced motion", "Bar and menu transitions collapse; content remains readable"]])
n9 = StudyNote("Applies to both options. These are shell-wide rules, not per-page choices.")
n10 = StudyPanel("Shell rules", "Shared by every page under the shell.", "Shared", [n8, n9])
n11 = StudyTable(["State", "Shell behaviour"], [["Reading", "Bars stay put; the page owns its own loading presentation"], ["Empty", "Bars stay put; the page states what an empty result means and what to do"], ["Unavailable", "Bars stay put; the page names the source that could not be read"], ["Signed out", "Bottom bar is not rendered; the menu carries account actions only"]])
n12 = StudyNote("The shell never reports a page state on a page's behalf.")
n13 = StudyPanel("Shell states", "What the chrome does while a page resolves.", "Shared", [n11, n12])
n14 = StudyTable(["Family", "Study", "Status"], [["Phone shell", "This study", "Chosen"], ["Report and list pages", "mobile-report-list", "Chosen"], ["Detail pages", "mobile-detail", "Chosen"], ["Search and filters", "mobile-filter-bar", "Chosen"], ["States", "mobile-states", "Chosen"]])
n15 = StudyNote("Sibling studies in this family set.")
n16 = StudyDetails("Family set", "The other phone studies, and their current standing.", [n14, n15])
n17 = StudyNote("Synthetic design values. Navigation destinations, labels and counts are invented. The native shell keeps its own navigation source, session state, confirmations and theme tokens.")
n18 = StudyShell("shell", [n1, n4, n7, n10, n13, n16, n17])
n19 = StudyHeading("Design artifact", "Phone shell", "The native implementation is verified separately at phone widths in both supported themes.")
n20 = Stack([n19, n18])

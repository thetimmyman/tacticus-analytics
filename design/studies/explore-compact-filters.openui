root = n14
n1 = StudyHeading("Layout family", "Explore: filters and summary", "Public guild list on a phone. The first guild card should start in the first screen, with search, cluster and sort still visible.")
n2 = StudyTable(["Block", "Height on a 390px phone", "Notes"], [["Title and subtitle", "about 130px", "One-line title, two-line subtitle"], ["Search", "44px", "Full width, labelled"], ["Cluster and Sort", "about 70px", "Side by side, each labelled"], ["Rarity strip", "about 90px", "Always open; two wrapped rows"], ["Last updated and Refresh", "about 50px", "Own row"], ["Summary figures", "about 90px", "Two by two"]])
n3 = StudyNote("Today's layout. The first guild card starts below the fold, so a phone visitor sees controls and totals before any guild.")
n4 = StudyPanel("Option A - all controls open (current)", "Nothing collapses; every control costs a row.", "Rejected", [n2, n3])
n5 = StudyTable(["Block", "Behaviour"], [["Search", "Full width, always visible"], ["Cluster and Sort", "Primary filters, two columns, always visible, 44px targets"], ["Rarity", "One disclosure button that says how many differ from the default; opens in place"], ["Refresh", "Same row as the Rarity button; last updated time below the figures"], ["Reset", "Appears when search, cluster or rarity differs from its default; clears all three"], ["Summary figures", "One row of four, labels wrap instead of shrinking"]])
n6 = StudyNote("Chosen option. It is the shared filter-bar family: search and primary filters never hide, the secondary group says when it is not at its default, and Reset covers the collapsed group too. Season shows a dash when the data does not say, never a guess.")
n7 = StudyPanel("Option B - shared filter bar with collapsed rarity", "Primary filters stay; rarity collapses behind one control.", "Chosen", [n5, n6])
n8 = StudyTable(["Block", "Behaviour"], [["Filters", "One Filters button for everything"], ["Search", "Revealed with the filters"], ["Active state", "Count only"]])
n9 = StudyNote("Rejected. It is the shortest header but hides the search box that most visitors start with, and a changed cluster or sort is invisible while closed.")
n10 = StudyPanel("Option C - one Filters button", "Everything collapsed.", "Rejected", [n8, n9])
n11 = StudyTable(["State", "Behaviour"], [["Reading", "Controls disabled, skeleton figures and cards"], ["Rarity not default", "Button reads Rarity (1 active); Reset visible"], ["No guilds loaded", "Season shows a dash; no invented season number"], ["No matches", "Empty message names the filters; Reset sits just above it"], ["Refreshing", "Refresh button disabled and labelled Refreshing"]])
n12 = StudyNote("Rarity changes which boss hits each card shows. It does not remove guilds from the list, so it is a display setting and sits in the collapsed group.")
n13 = StudyPanel("States and rules", "Shared by the chosen option.", "Shared", [n11, n12])
n14 = Stack([n1, n4, n7, n10, n13])

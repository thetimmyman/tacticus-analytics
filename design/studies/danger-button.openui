root = n15
n1 = StudyHeading("Layout family", "Destructive outline button", "The Disable button on a Discord invite row and the Delete Guild button in the cluster delete dialog. Both sit beside neutral outline buttons and have to read on every guild theme, at rest and on hover.")
n2 = StudyTable(["Part", "Today", "Problem"], [["Label", "Fixed red 500 or 600 text on the card", "Rest label is under 4.5:1 on 61 of 62 themes on the invite row (lowest 1.5:1) and 54 of 62 on the dialog card (lowest 1.3:1); the dialog hover reads 3.5:1"], ["Hover", "Near-white fill fades in over 0.3 s", "Fill and label cross at about 1.0:1 to 1.2:1 half-way through the fade on dark themes"], ["Border", "Red 500 on one, theme border on the other", "The two destructive buttons do not match"]])
n3 = StudyNote("Today's buttons. Red comes from the Tailwind palette instead of the theme's danger colour, and the hover fade starts from the dark card.")
n4 = StudyPanel("Option A - current", "Palette red text, near-white hover fill.", "Rejected", [n2, n3])
n5 = StudyTable(["Part", "Behaviour"], [["Rest", "Same label colour as the neighbouring outline buttons, border in the theme's danger colour"], ["Hover", "Opaque danger fill with the on-danger label, swapped in one frame"], ["Focus", "Same ring as every other button"], ["Disabled", "Half strength, no hover"]])
n6 = StudyNote("Chosen. The label stays the page's own text colour until the fill is under it, so no frame is worse than the neighbouring Cancel and Copy buttons (31 of 62 themes still under 4.5:1 on the invite row and 35 in the dialog, lowest 2.2:1, because those themes' own text colour is weak) and hover reads 6.5:1 or better; the danger tone is carried by the border at rest and by the fill on hover, using the same status tokens as the confirmation dialog.")
n7 = StudyPanel("Option B - danger outline, filled on hover", "Quiet at rest, unmistakable under the pointer.", "Chosen", [n5, n6])
n8 = StudyTable(["Part", "Behaviour"], [["Rest", "Opaque danger fill, on-danger label"], ["Hover", "Fill steps toward the far end"]])
n9 = StudyNote("Rejected. Reads everywhere, but every invite row would carry a loud red block next to its copy buttons.")
n10 = StudyPanel("Option C - filled danger at rest", "Always solid.", "Rejected", [n8, n9])
n11 = StudyTable(["Part", "Behaviour"], [["Rest", "Neutral outline"], ["Hover", "Neutral hover"]])
n12 = StudyNote("Rejected. A destructive action that looks like Copy Code invites a mis-click, and Disable has no confirmation step.")
n13 = StudyPanel("Option D - neutral outline", "No tone at all.", "Rejected", [n11, n12])
n14 = StudyTable(["State", "Behaviour"], [["Rest", "Same label colour as the neighbouring outline buttons, border in the danger colour"], ["Hover", "Danger fill, label 4.5:1 or better, one frame"], ["Keyboard focus", "Ring as on the other buttons"], ["Narrow phone", "Full width in the invite row, stacked under the copy buttons"], ["Disabled", "Half strength; the dialog button stays off until the guild name is typed"]])
n15 = Stack([n1, n4, n7, n10, n13, StudyPanel("States", "Shared by the chosen option.", "Shared", [n14])])

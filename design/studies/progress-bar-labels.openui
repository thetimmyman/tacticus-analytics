root = n13
n1 = StudyHeading("Layout family", "Progress bar percentage label", "The shared bar behind boss and prime performance on the dashboard (average against best damage, one bar per boss or prime, on a card, one to three columns). The percentage sits in the middle of the track, so as the fill grows it slides under the label.")
n2 = StudyTable(["Part", "Today", "Problem"], [["Fill", "Primary-to-accent gradient, or fixed green, red, yellow", "Fine"], ["Label", "Theme text colour, centred on the whole track", "Under about 40 percent the label sits on the empty track and reads. From about 50 percent it sits on the fill: 1.4 to 2.7:1 on the dark theme for every colour, so the figure is unreadable exactly when the bar is long; around 50 percent half the glyphs are on each surface"]])
n3 = StudyNote("Today's bar. The label colour cannot be right for both surfaces, because they change with the value.")
n4 = StudyPanel("Option A - one theme-coloured label", "Current behaviour.", "Rejected", [n2, n3])
n5 = StudyTable(["Part", "Behaviour"], [["Label", "Still centred on the track, drawn twice and cut at the fill edge: the part over the fill uses the fill's own label colour, the part over the empty track keeps the theme text colour"], ["Fill", "Theme-colour bars use the shared call-to-action stops, so one label colour reads along the whole gradient on all 62 themes; green, red and yellow keep their status colours with a black label"], ["Reading", "One readable copy for assistive technology; the second copy is hidden from it"]])
n6 = StudyNote("Chosen. Every glyph sits on the surface its colour was chosen for at any value, nothing moves, and the bar keeps its at-a-glance number.")
n7 = StudyPanel("Option B - label split at the fill edge", "Two-tone label.", "Chosen", [n5, n6])
n8 = StudyTable(["Part", "Behaviour"], [["Label", "Moves into the header row beside AVG and MAX; the bar carries no text"]])
n9 = StudyNote("Rejected. Always readable, but the header already carries the name, AVG, MAX and the cluster comparison; a fourth item wraps on a phone, and the number leaves the bar it describes.")
n10 = StudyPanel("Option C - percentage in the header", "Bar without text.", "Rejected", [n8, n9])
n14 = StudyPanel("Option D - label inside the fill", "Right-aligned.", "Rejected", [n11, n12])
n15 = StudyTable(["State", "Behaviour"], [["Below 5 percent", "No label, as before"], ["Stacked bar segments", "Segment labels take the segment's own label colour and are cut at the segment edge so they never spill onto a neighbour"], ["Light and dark themes", "Both use the same tokens; the label over the track keeps the theme text colour"], ["Motion", "The cut follows the fill width, so it moves with the bar if the width is ever animated"]])
n11 = StudyTable(["Part", "Behaviour"], [["Label", "Right-aligned inside the fill, hidden when the fill is narrow"]])
n12 = StudyNote("Rejected. The fill is narrow exactly for small values, so the figure would disappear there, and a label wider than a short fill still spills onto the track.")
n13 = Stack([n1, n4, n7, n10, n14, StudyPanel("States", "Shared by the chosen option.", "Shared", [n15])])

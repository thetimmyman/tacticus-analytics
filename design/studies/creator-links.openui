root = n16
n1 = StudyHeading("Layout family", "Creators: resource link buttons", "Public Creators page and the home page section. About 30 link buttons (YouTube, Discord, Reddit, spreadsheets, GitHub, websites) sit on cards; each label must read on its own fill on every one of the 62 themes, at rest and on hover.")
n2 = StudyTable(["Link style", "Fill", "Label today", "Measured on 8 themes"], [["Website (Official Site, Store, tools)", "theme primary to blue-500", "theme text", "8 of 8 below 4.5:1, worst 1.03:1"], ["YouTube", "red-600 to red-500", "theme text", "8 of 8 below 4.5:1, worst 1.01:1"], ["Discord", "indigo-600 to indigo-500", "theme text", "8 of 8 below 4.5:1, worst 1.10:1"], ["Reddit", "orange-600 to orange-500", "theme text", "7 of 8 below 4.5:1, worst 1.03:1"], ["Spreadsheets", "green-600 to green-500", "theme text", "7 of 8 below 4.5:1, worst 1.00:1"], ["GitHub", "theme card to theme background", "theme text", "6 of 8 below 4.5:1 (hover brightens), worst 1.65:1"], ["TikTok", "theme background gradient", "theme text", "2 of 8 below 4.5:1, worst 4.10:1"]])
n3 = StudyNote("Today. The label is the theme's own text colour, which was chosen for the page, not for a red, green or blue fill: a silver or white theme puts light text on a bright fill, a light theme puts dark text on red. Hover also brightens the fill under the label.")
n4 = StudyPanel("Option A - theme label on brand fill (current)", "One label colour for every fill.", "Rejected", [n2, n3])
n5 = StudyTable(["Link style", "Fill", "Label", "Lowest contrast"], [["YouTube", "red-700 to red-600; red-800 to red-700 on hover", "white", "4.76:1"], ["Discord", "indigo-700 to indigo-600", "white", "6.44:1"], ["Reddit", "orange-800 to orange-700", "white", "5.23:1"], ["Spreadsheets", "green-800 to green-700", "white", "4.94:1"], ["GitHub", "slate-900 to slate-700", "white", "10.3:1"], ["TikTok", "zinc-950 to zinc-800", "white", "above 12:1"], ["Website", "theme primary; theme accent on hover", "on-primary; on-accent on hover", "4.83:1 or better on all 62 themes"]])
n6 = StudyNote("Chosen. Platform colour and icon still say where a link goes; the fill is a dark tier so a white label always passes, and hover darkens instead of brightening. Website links are the only theme-coloured style and use the label token made for a primary fill. The film glyph on the red avatar is white for the same reason.")
n7 = StudyPanel("Option B - fixed dark brand fills, white label; website uses the theme pair", "Each style states its fill and label together.", "Chosen", [n5, n6])
n8 = StudyTable(["Aspect", "Behaviour"], [["Fill", "Every button takes the theme primary with its on-primary label"], ["Platform cue", "Icon and text only; 30 buttons look identical"], ["Cost", "A visitor scanning for YouTube or Discord loses the colour cue the cards already use"]])
n9 = StudyNote("Rejected. It would pass on every theme, but it removes the platform colour that makes a long list of creators easy to scan.")
n10 = StudyPanel("Option C - every link in the theme primary", "One style for all.", "Rejected", [n8, n9])
n11 = StudyTable(["Aspect", "Behaviour"], [["Fill", "Card surface with a border; colour only in the icon"], ["Label", "Theme text on the theme card"], ["Risk", "Passes only where a theme's own text and card pair already read; many themes' card text is near 2:1"]])
n12 = StudyNote("Rejected. It moves the problem to the theme definitions and still needs a second fix there.")
n13 = StudyPanel("Option D - outline buttons", "Colour in the icon only.", "Rejected", [n11, n12])
n14 = StudyTable(["State", "Behaviour"], [["Rest", "Brand fill gradient, white label and icon, 14px bold"], ["Hover", "Fill darkens one tier, button lifts 2px with a shadow; no brightening filter; no lift for reduced motion"], ["Keyboard focus", "A white ring between two black bands, so it shows on any card and any fill"], ["Phone", "One column, buttons full width of the card"], ["Unknown destination", "Not applicable: every link is a fixed public address"]])
n15 = StudyNote("Unchanged: link addresses, labels, order, target and rel attributes.")
n16 = Stack([n1, n4, n7, n10, n13, StudyPanel("States and rules", "Shared by the chosen option.", "Shared", [n14, n15])])

root = n16
n1 = StudyHeading("Layout family", "Explore: guild list pager", "Public guild list, any page after the first. Previous and Next must stay on screen and reachable from a 320px phone to a 1023px tablet or landscape phone, and a keyboard or screen-reader user must land on the new page, not on a control that moved out of view.")
n2 = StudyTable(["Width", "What happens today"], [["390px, page 4 of 7", "Seven numbered buttons plus Previous and Next need about 410px: Previous is cut off at the left edge and Next at the right, and the page scrolls sideways"], ["360px and 320px", "Same row, 36 to 56px further off screen. Switching to the short row at 640px would still leave 640 to about 800px overflowing, so landscape phones scroll sideways too"], ["After a page change", "The page jumps to the top and keyboard focus stays on the pressed button, now out of view; on the last page Next disables itself and focus falls to the document"]])
n3 = StudyNote("Today's layout. The pager fails reflow on every phone once the list has more than four pages, and gives a keyboard user no sign of where they are.")
n4 = StudyPanel("Option A - keep the numbered row (current)", "One row of numbers for every width.", "Rejected", [n2, n3])
n5 = StudyTable(["Width", "Behaviour"], [["Below 1024px", "Previous, a position label (Page 4 of 7) and Next in one row, each target 44px high; no numbered buttons"], ["1024px and wider", "Unchanged numbered row with first and last page shortcuts"], ["Landmark", "A navigation named Guild list pages; the current page carries aria-current"], ["After a change", "Focus moves to the list (named Guilds, page 4 of 7) and the list scrolls to its top edge"]])
n6 = StudyNote("Chosen. The label is the only thing that must be readable at a glance below desktop width; a user who wants a far page uses search or the cluster filter, which the list already offers above it.")
n7 = StudyPanel("Option B - short row below 1024px, numbers from 1024px", "Position label replaces the numbers below 1024px.", "Chosen", [n5, n6])
n8 = StudyTable(["Width", "Behaviour"], [["Phone", "Previous, a native page picker and Next in one row"], ["Keyboard", "A closed native select fires a change on every arrow key in some browsers, so the first arrow press would move focus away from the picker"]])
n9 = StudyNote("Rejected. Jumping straight to a page is useful, but focus moving on each arrow press would trap the keyboard user.")
n10 = StudyPanel("Option C - native page picker on a phone", "Previous, picker, Next.", "Rejected", [n8, n9])
n11 = StudyTable(["Width", "Behaviour"], [["Phone", "Numbers wrap onto a second row under Previous and Next"], ["Cost", "About 90px of extra height on every page of every list, and the two rows read as two controls"]])
n12 = StudyNote("Rejected. It fixes the clipping but spends vertical space on the numbers the phone user rarely needs.")
n13 = StudyPanel("Option D - wrap the numbers", "Two rows on a phone.", "Rejected", [n11, n12])
n14 = StudyTable(["State", "Behaviour"], [["First page", "Previous is disabled and stays visible; label reads Page 1 of 7"], ["Last page", "Next is disabled; focus is on the list, never on the document"], ["One page only", "The pager is not shown and the list is named Guilds"], ["Filter changes the page", "The list resets to page 1 without taking focus from the search box"], ["Current page chosen again", "Nothing moves"]])
n15 = StudyNote("The per-page selector is disabled (the page size is fixed at 20); it gets a name and stays.")
n16 = Stack([n1, n4, n7, n10, n13, StudyPanel("States and rules", "Shared by the chosen option.", "Shared", [n14, n15])])

root = n18
n1 = StudyHeading("Layout family", "Personal Potential upgrade path: panel surface on Light Mode", "The step cards sit on a dark panel with tinted fills. On the Light theme the status palette and the theme text colours resolved for a white page, so labels and gain pills landed dark on that dark panel.")
n2 = StudyTable(["Part", "Today", "Problem"], [["Panel", "Translucent slate gradient over the page", "A white page shows through the edges and middle"], ["Tier labels", "Palette tints (sky, emerald, amber) and theme text colours", "Resolve for the light page: 1.0:1 to 1.7:1 on the dark panel"], ["Gain pills and strength badges", "Palette 200 tints", "1.3:1 to 1.7:1 on the same panel"], ["Hero portraits and swap badges", "Theme card and background colours", "Light fills behind light initials"]])
n3 = StudyNote("Measured in Chromium on the real Light theme: 53 of 63 text elements under 4.5:1 at desktop width and 54 of 63 on a phone, worst 1.0:1.")
n4 = StudyPanel("Option A - current", "Panel and labels follow the page theme.", "Rejected", [n2, n3])
n5 = StudyTable(["Part", "Behaviour"], [["Panel", "Dark scope for the whole panel plus an opaque black base under the gradient"], ["Labels and badges", "Palette colours only (slate, sky, emerald, amber, rose): the same on every theme"], ["Fills", "Slate fills for portraits and icon rings, deeper swap badges, instead of theme fills"], ["Tier labels", "Light tints (sky 100, emerald 200, amber 100, slate 200) so a dimmed card still reads"]])
n6 = StudyNote("Chosen. The panel is a fixed dark showpiece (glows, blur, emerald edge) on every theme, like the season recap panels, so its text is decided once and measured once; Light and Dark render identically.")
n7 = StudyPanel("Option B - fixed dark island with palette text", "One surface, one set of colours.", "Chosen", [n5, n6])
n8 = StudyTable(["Part", "Behaviour"], [["Panel", "Light card surface on the Light theme, dark panel elsewhere"], ["Labels", "Tints picked per theme: deeper on Light, lighter on dark"], ["Glows", "Tinted shadows instead of blur on Light"]])
n9 = StudyNote("Rejected. Two looks to keep in step, and every tint and glow needs a second contrast check on every guild theme; the cards already look like part of a dark showpiece.")
n10 = StudyPanel("Option C - adapt the panel to Light Mode", "A light variant of the whole path.", "Rejected", [n8, n9])
n11 = StudyTable(["Part", "Behaviour"], [["Scope", "A token reset on dark islands only on Light Mode, so theme text colours resolve for the island"], ["Reach", "Every dark panel in the app, not just this one"]])
n12 = StudyNote("Deferred. The right fix for theme text inside every other dark island, but it is a theme-system change with its own review; this panel does not need theme text at all.")
n13 = StudyPanel("Option D - token reset for dark islands", "Keep theme text colours, rescope them.", "Deferred", [n11, n12])
n14 = StudyTable(["State", "Behaviour"], [["Active card", "Full strength, tier label, damage, portraits with strength badges, availability pill"], ["Inactive card", "Dimmed to 60-85%; tier label still at least 4.5:1"], ["Locked step", "Slate card, lock icon, Requires line; portraits greyscale and dimmed to 85% (was 70%) so their small text holds 3.5:1 on a dimmed card"], ["Needs investment", "Rose badge and portrait ring, unchanged"], ["Phone", "Cards stack in one panel; nothing changes in layout"]])
n15 = StudyNote("Only colours and fills change. Layout, text sizes, order, interaction and the dimming of inactive cards stay as they are.")
n16 = StudyPanel("States", "Shared by the chosen option.", "Shared", [n14, n15])
n17 = StudyNote("Small text on dimmed cards (6-9px) is a separate size finding and is not changed here.")
n18 = Stack([n1, n4, n7, n10, n13, n16, n17])

root = n15
n1 = StudyHeading("Layout family", "Outline and ghost button hover", "The shared Button used for secondary actions (Cancel, Refresh, filters, row actions) on 57 screens. It sits on the page, on cards and in dialogs, so the surface behind it changes and the theme's own text colour is the label.")
n2 = StudyTable(["Part", "Today", "Problem"], [["Rest", "Faint theme border, transparent fill, theme text label", "Fine"], ["Hover", "Fill becomes the card tint (a 10-20% wash of the theme's secondary colour)", "On a card or the page the wash is almost the same colour: the step is under 1.15:1 on 51 of 62 themes, so hover barely shows; and it moves the fill toward the label on 41 themes, so the label reads worse under the pointer than at rest"]])
n3 = StudyNote("Today's outline button. Ghost is the same without the border, so its hover is the only chrome it ever shows.")
n4 = StudyPanel("Option A - card tint on hover", "Current behaviour.", "Rejected", [n2, n3])
n5 = StudyTable(["Part", "Behaviour"], [["Rest", "Unchanged"], ["Hover", "Border takes the label colour and a 1px inner ring in the same colour joins it (2px, no layout shift); the fill does not change"], ["Label", "Same background in every frame, so its contrast is the rest contrast on every theme"], ["Tone", "The ring follows the button's own label colour, so a coloured outline button keeps its colour"]])
n6 = StudyNote("Chosen. The cue is as strong as the label itself (at least 1.5 times the rest border on all 62 themes) and cannot cost any theme label contrast. Where a theme's own text is weak (the theme-data finding), the ring is as weak as the text, which is still far above the old faint border.")
n7 = StudyPanel("Option B - label-coloured ring on hover", "No fill change, nothing for the label to lose.", "Chosen", [n5, n6])
n8 = StudyTable(["Part", "Behaviour"], [["Hover", "Overlay toward black or white, strength and direction computed per theme from the label and the surfaces behind"]])
n9 = StudyNote("Rejected. A step toward the label costs label contrast and a step away from it is invisible on dark pages; no overlay reaches a visible step under the label floor on 19 of 62 themes, so it would still need the ring as a fallback, plus new tokens in all three theme paths.")
n10 = StudyPanel("Option C - computed overlay", "Per-theme tint.", "Rejected", [n8, n9])
n11 = StudyTable(["Part", "Behaviour"], [["Hover", "Solid accent fill with the on-accent label"]])
n12 = StudyNote("Rejected. Always readable, but every Cancel and Refresh would flash the guild's loudest colour; hover would out-shout the primary action.")
n13 = StudyPanel("Option D - solid accent on hover", "Bootstrap-style outline.", "Rejected", [n11, n12])
n14 = StudyTable(["State", "Behaviour"], [["Rest", "Unchanged"], ["Hover (pointer devices only)", "Ring in the label colour; ghost shows the ring it never had at rest"], ["Keyboard focus", "Same focus ring as before; it stacks with the hover ring"], ["Disabled and loading", "No hover, half strength"], ["Call sites with their own colours", "Ring follows the label colour; their own hover classes still apply"], ["Forced colours", "Border and ring survive as system colours"]])
n15 = Stack([n1, n4, n7, n10, n13, StudyPanel("States", "Shared by the chosen option.", "Shared", [n14])])

root = n15
n1 = StudyHeading("Layout family", "Outline and ghost button hover", "The shared Button used for secondary actions (Cancel, Refresh, filters, row actions): about 150 call sites. It sits on the page, on cards and in dialogs, so the surface behind it changes and the theme's own text colour is the label.")
n2 = StudyTable(["Part", "Today", "Problem"], [["Rest", "Faint theme border, transparent fill, theme text label", "Fine"], ["Hover", "Fill becomes the card tint (a 10-20% wash of the theme's secondary colour)", "The wash moves the fill toward the label, so on 8 of 13 and 9 of 14 sampled themes the label reads worse under the pointer than at rest and ends under 4.5:1 (lowest 1.9:1); the step against the surface is under 1.15:1 on 4 to 7 of those themes, so hover barely shows there"]])
n3 = StudyNote("Today's outline button. Ghost is the same without the border, so its hover is the only chrome it ever shows.")
n4 = StudyPanel("Option A - card tint on hover", "Current behaviour.", "Rejected", [n2, n3])
n5 = StudyTable(["Part", "Behaviour"], [["Rest", "Unchanged"], ["Hover", "An inner ring in the label colour: 2px on the outline, 1px on the ghost; no layout shift; the fill and the border colour do not change"], ["Label", "Same background in every frame, so its contrast is the rest contrast on every theme"], ["Tone", "A call site's own border colour stays; the ring follows the label colour that is actually shown"]])
n6 = StudyNote("Chosen. The cue is as strong as the label itself (at least 1.5 times the faint rest border on all 62 themes) and cannot cost any theme label contrast. Where a theme's own text is weak (26 of 62 themes read the label under 3:1 on a card, the theme-data finding) the ring is as weak as the text, which is still well above the old faint border.")
n7 = StudyPanel("Option B - label-coloured inner ring on hover", "No fill change, nothing for the label to lose.", "Chosen", [n5, n6])
n8 = StudyTable(["Part", "Behaviour"], [["Hover", "Overlay toward black or white, strength and direction computed per theme from the label and the surfaces behind"]])
n9 = StudyNote("Rejected. A step toward the label costs label contrast and a step away from it is hard to see on dark pages, so it would still need the ring as a fallback on many themes, plus new tokens in all three theme paths.")
n10 = StudyPanel("Option C - computed overlay", "Per-theme tint.", "Rejected", [n8, n9])
n11 = StudyTable(["Part", "Behaviour"], [["Hover", "Solid accent fill with the on-accent label"]])
n12 = StudyNote("Rejected. Always readable, but every Cancel and Refresh would flash the guild's loudest colour; hover would out-shout the primary action.")
n13 = StudyPanel("Option D - solid accent on hover", "Bootstrap-style outline.", "Rejected", [n11, n12])
n14 = StudyTable(["State", "Behaviour"], [["Rest", "Unchanged"], ["Hover (pointer devices only)", "Inner ring in the label colour; ghost shows the ring it never had at rest"], ["Keyboard focus", "Same focus ring as before; it stacks with the hover ring"], ["Disabled and loading", "No hover, half strength"], ["Call sites with their own colours", "Their border and fill classes still apply; the ring is the label colour"], ["Forced colours", "No hover cue (box-shadow is dropped), as before; the focus outline remains"]])
n15 = Stack([n1, n4, n7, n10, n13, StudyPanel("States", "Shared by the chosen option.", "Shared", [n14])])

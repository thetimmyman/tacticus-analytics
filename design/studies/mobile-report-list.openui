root = n22
n1 = StudyHeading("Layout family", "Report and list pages", "How a report reads on a phone: which rows lead, what stays a table, and what moves behind a disclosure.")
n2 = StudyTable(["Part", "Rule", "Authority"], [["Lead", "The next decision or the active work, in one short block", "Page owner"], ["Summary", "At most four figures, two per row on a phone", "Page owner"], ["Primary list", "Cards, one per row, complete title on its own line", "Shared list primitive"], ["Filters", "Search and the common filters stay visible", "Shared filter bar"], ["Provenance", "Behind a labelled disclosure", "Page owner"]])
n3 = StudyNote("Chosen option for narrative lists: reports, rosters, leaderboards, assignments. The card shows the fields a decision actually uses; the rest of the row stays reachable on the detail page.")
n4 = StudyPanel("Option A - card list", "One card per row, ordered by what needs a decision.", "Chosen", [n2, n3])
n5 = StudyTable(["Part", "Rule", "Authority"], [["Table", "Stays a table, inside a labelled horizontal scroll container", "Shared table primitive"], ["First column", "Sticky, so a row stays identifiable while scrolling", "Shared table primitive"], ["Caption", "States that the table scrolls sideways", "Shared table primitive"], ["Density", "Compact rows; type does not drop below the data-table size", "Shared tokens"]])
n6 = StudyNote("Chosen option for wide numeric matrices, where cards would hide the comparison the table exists to make. Deliberate sideways scroll is fine; accidental page-wide overflow is not.")
n7 = StudyPanel("Option B - contained scrolling table", "For wide numeric matrices only.", "Chosen for matrices", [n5, n6])
n8 = StudyTable(["Report", "Rows", "Layout", "Why"], [["Sample report overview", "12", "Card list", "Each row is a separate decision"], ["Sample leaderboard", "40", "Card list", "Top of list matters; rank order is the point"], ["Sample roster", "60", "Card list", "Short rows, few columns"], ["Sample unit matrix", "24 x 9", "Scrolling table", "The comparison across columns is the point"], ["Sample activity log", "200", "Card list", "Newest first, detail behind a disclosure"]])
n9 = StudyNote("Invented fixture. The choice is per report, made on the row shape, not applied blanket-wide.")
n10 = StudyPanel("Which layout, per report", "Applied per page; the shared primitives serve both.", "Fixture", [n8, n9])
n11 = StudyTable(["Condition", "Presentation"], [["Reading", "Named skeleton in the shape of the real list, not a spinner alone"], ["Empty", "Says what an empty result means here and what would fill it"], ["Partial", "Shows what was read and what was not; a partial list is not a full one"], ["Stale", "Keeps the last values and says when they were read"], ["Unavailable", "Names the source that could not be read; no invented zero"], ["Observed zero", "A real zero, distinct from an absent observation"]])
n12 = StudyNote("Shared across both options. See the states study.")
n13 = StudyPanel("States", "Every list must render all six.", "Shared", [n11, n12])
n14 = StudyTable(["Check", "Result"], [["Complete titles", "Wrap; no ellipsis on a primary title"], ["Horizontal overflow", "None outside the labelled scroll container"], ["Touch targets", "Every row control meets the minimum"], ["Focus order", "Follows visual order through filters and rows"], ["Dark theme", "Same hierarchy without colour alone"], ["Reduced motion", "Content appears without animation"]])
n15 = StudyNote("Native verification checklist for this family. Results are recorded separately from this study.")
n16 = StudyDetails("Native checks", "What must be inspected in the built app, not in this artifact.", [n14, n15])
n17 = StudyTable(["Family", "Study", "Status"], [["Phone shell", "mobile-shell", "Chosen"], ["Report and list pages", "This study", "Chosen"], ["Detail pages", "mobile-detail", "Chosen"], ["Search and filters", "mobile-filter-bar", "Chosen"], ["States", "mobile-states", "Chosen"]])
n18 = StudyNote("Sibling studies in this family set.")
n19 = StudyDetails("Family set", "The other phone studies, and their current standing.", [n17, n18])
n20 = StudyNote("Synthetic design values. Report names, counts and states are invented. The native app keeps its own data sources, routing, authorization and shared components.")
n21 = StudyShell("reports", [n1, n4, n7, n10, n13, n16, n19, n20])
n22 = Stack([n21])

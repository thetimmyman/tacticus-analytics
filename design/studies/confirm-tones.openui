root = n16
n1 = StudyHeading("Layout family", "Confirmation dialog: warning and danger tones", "Shared dialog behind deleting a key, a cluster or an assignment. The confirm button has to read on every guild theme, at rest and on hover.")
n2 = StudyTable(["Part", "Today", "Problem"], [["Danger confirm", "80% danger tint over the card, white label", "Label reads 3.4:1 to 4.9:1 at rest and drops to 2.8:1 on hover on dark themes"], ["Warning confirm", "80% warning tint, page-background label", "Label falls under 4.5:1 on Light Mode (3.6:1)"], ["Hover", "Tint turns solid", "Hover is the weaker state: the colour moves toward the label colour"], ["Title", "Tone colour on the card", "Tone colour can sit under 4.5:1 on brighter card surfaces"]])
n3 = StudyNote("Today's tones. Danger and warning come from the theme, the label does not follow them, and the tint is translucent so the card behind it changes the result.")
n4 = StudyPanel("Option A - current", "Translucent tint, fixed label.", "Rejected", [n2, n3])
n5 = StudyTable(["Part", "Behaviour"], [["Confirm fill", "Opaque danger or warning colour from the theme"], ["Label", "Black or white, whichever reads better on that colour, from a theme token set with the other on-fill labels"], ["Hover", "Fill moves a step away from the label colour (toward it when the fill is already at the far end), so hover is visible and never drops under 4.5:1"], ["Title", "Page text colour, 20px bold; warning and danger add a round badge with an icon in the status fill and its label"], ["Focus", "Unchanged; a transparent border keeps the button edge in forced-colours mode"]])
n6 = StudyNote("Chosen. One system: the same rule that labels primary, secondary, accent and gradient controls now covers the two status fills, so a theme that changes its danger colour keeps a readable label.")
n7 = StudyPanel("Option B - status fill with a computed label", "Opaque theme colour, computed label, stronger hover.", "Chosen", [n5, n6])
n8 = StudyTable(["Part", "Behaviour"], [["Danger confirm", "Fixed dark red with a white label on every theme"], ["Warning confirm", "Fixed amber with a black label"], ["Hover", "One step darker"]])
n9 = StudyNote("Rejected. Reads everywhere, but it adds a second red next to the theme's danger colour used by badges and alerts, and a theme that retunes its danger colour would not reach this dialog.")
n10 = StudyPanel("Option C - fixed palette", "Theme-independent red and amber.", "Rejected", [n8, n9])
n11 = StudyTable(["Part", "Behaviour"], [["Confirm", "Neutral filled button for every tone"], ["Tone", "Title icon and colour only"]])
n12 = StudyNote("Rejected. The destructive action stops looking different from a harmless one at the moment it matters.")
n13 = StudyPanel("Option D - neutral button, tone in the title", "Tone is carried by title colour alone.", "Rejected", [n11, n12])
n14 = StudyTable(["State", "Behaviour"], [["Rest", "Opaque fill, label at least 4.5:1"], ["Hover", "Lighter or darker step, label at least 4.5:1"], ["Focus", "Browser focus ring, unchanged"], ["Busy", "Spinner and Working label, button disabled at reduced strength"], ["Narrow phone", "Buttons stack full width, 44px high"]])
n15 = StudyNote("Cancel and the description keep the theme's own text colours; they were not the failing part.")
n16 = Stack([n1, n4, n7, n10, n13, StudyPanel("States", "Shared by the chosen option.", "Shared", [n14, n15])])

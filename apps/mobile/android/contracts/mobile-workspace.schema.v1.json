{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Secret-free portable mobile workspace v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "mode", "player", "raids"],
  "properties": {
    "schemaVersion": {
      "const": "mobile-workspace/v1"
    },
    "mode": {
      "enum": ["personal", "historical", "synthetic-demo"]
    },
    "player": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "displayName",
            "units",
            "resources",
            "upstreamUpdatedAt"
          ],
          "properties": {
            "displayName": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "units": {
              "type": "array",
              "maxItems": 20000,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "name", "rank", "xpLevel"],
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "rank": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 23
                  },
                  "xpLevel": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 60
                  }
                }
              }
            },
            "resources": {
              "type": "object",
              "additionalProperties": false,
              "required": ["guildRaidTokens", "bombTokens"],
              "properties": {
                "guildRaidTokens": {
                  "anyOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "current",
                        "max",
                        "nextTokenInSeconds",
                        "regenDelayInSeconds"
                      ],
                      "properties": {
                        "current": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        },
                        "max": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        },
                        "nextTokenInSeconds": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        },
                        "regenDelayInSeconds": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        }
                      }
                    }
                  ]
                },
                "bombTokens": {
                  "anyOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "current",
                        "max",
                        "nextTokenInSeconds",
                        "regenDelayInSeconds"
                      ],
                      "properties": {
                        "current": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        },
                        "max": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        },
                        "nextTokenInSeconds": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        },
                        "regenDelayInSeconds": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        }
                      }
                    }
                  ]
                }
              }
            },
            "upstreamUpdatedAt": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          }
        }
      ]
    },
    "raids": {
      "type": "array",
      "maxItems": 20000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["player", "boss", "damage", "tokens", "observedAt"],
        "properties": {
          "player": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "boss": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "damage": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "tokens": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "observedAt": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        }
      }
    }
  }
}

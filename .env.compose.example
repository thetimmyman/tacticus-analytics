# Copy this file to .env.local, then replace every key value with the output
# from your local Supabase instance. These placeholders are not credentials.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
SITE_URL=http://localhost:3000

# Browser requests come from your host browser; server requests come from Docker.
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
SUPABASE_URL=http://host.docker.internal:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace_with_local_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=replace_with_local_supabase_service_role_key

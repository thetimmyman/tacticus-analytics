# Development Dockerfile with hot reload support
FROM node:22-alpine

# Install dependencies required by the application build
RUN apk add --no-cache libc6-compat python3 py3-pip
RUN ln -sf python3 /usr/bin/python

WORKDIR /app

# Copy source before npm ci so workspace package links are present.
COPY . .

# Install dependencies
RUN npm ci --legacy-peer-deps

# Copy all source files (in dev, we'll override with volume mount)
COPY . .

ENV TACTICUS_PYTHON_CMD=/usr/bin/python3

# Expose port
EXPOSE 3000

# Development command
CMD ["npm", "run", "dev"]

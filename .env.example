# Supabase Configuration
# Copy this file to .env.local and update with your values.
#
# Getting a working local stack from a clean clone:
#   npm install
#   npm run supabase:start    # prints the API URL + anon key used below
#   npm run supabase:reset    # applies migrations, then loads supabase/seed.sql
#   npm run dev
#
# supabase/seed.sql creates a synthetic cluster (DEVC), three guilds and ~2.6k
# battle rows, and flips feature_releases to 'public'. Without that last step
# the app builds and serves but renders as an empty shell, because the release
# gate defaults to 'coming_soon' and fails closed.
#
# No production credentials are required for local development, and none of the
# operator-held secrets (per-guild Tacticus API keys, LOKI_SCRAPER_CLIENT_SECRET)
# can be shared -- features that depend on them stay inert locally.

# Local Development Supabase (default -- matches supabase/config.toml)
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_local_anon_key_from_supabase_start_output

# Hosted Supabase values are deployment-specific and are not required locally.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Other Environment Variables
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Local development process (matches README and NEXT_PUBLIC_SITE_URL)
PORT=3000
NEXT_PORT=3000
RESEND_API_KEY=your_resend_key_here

# Self-hosted deployment URLs (optional; use your own hostnames)
# API_EXTERNAL_URL=https://api.example.com
# SITE_URL=https://app.example.com
# ADDITIONAL_REDIRECT_URLS=https://app.example.com/**

# Custom Auth Domain Configuration (for avoiding spam filters)
# Option 1: Use main domain with /auth/v1 path (default)
# Option 2: Use an auth subdomain such as auth.example.com
# NEXT_PUBLIC_AUTH_URL=https://auth.example.com/auth/v1

# Optional: For API key encryption
ENCRYPTION_KEY=your_32_character_encryption_key_here

# Optional: For monitoring
MONITORING_WEBHOOK_URL=your_monitoring_webhook_url_here
# Optional: directory holding a runtime LOKI GlobalConfig override (in-cluster ConfigMap mount); unset = baked copy
LOKI_CONFIG_OVERRIDE_DIR=
DISCORD_ALERTS_ENABLED=false
METRICS_SECRET=your_metrics_secret_here

# Error & performance monitoring (Sentry + GlitchTip)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Public contact address on the privacy/CCPA/creators pages (build time).
NEXT_PUBLIC_CONTACT_EMAIL=
GLITCHTIP_DSN=
NEXT_PUBLIC_GLITCHTIP_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_REPLAYS_SESSION_SAMPLE_RATE=0
SENTRY_REPLAYS_ON_ERROR_SAMPLE_RATE=1.0
SENTRY_BOSS_THRESHOLD_MS=1200

# Discord OAuth Configuration (for Discord login)
NEXT_PUBLIC_DISCORD_CLIENT_ID=your_discord_client_id_here
DISCORD_CLIENT_SECRET=your_discord_client_secret_here

# Google OAuth Configuration (for Google login)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Discord Webhook Threads
DISCORD_MAJOR_VERSION_THREAD_ID=your_discord_major_thread_id

# Feature Flags
NEXT_PUBLIC_ENABLE_DISCORD_AUTH=false
NEXT_PUBLIC_ENABLE_GOOGLE_AUTH=false
NEXT_PUBLIC_REQUIRE_DISCORD_LINK=false
DISABLE_DISCORD_NEW_MEMBER_WEBHOOK=false
DISCORD_WEBHOOK_SECRET=
DISABLE_DISCORD_APPLICATION_WEBHOOK=false
DISABLE_DISCORD_VERSION_WEBHOOK=false

# Optional: For Vercel CLI deployments
# Get from: https://vercel.com/account/tokens
VERCEL_TOKEN=your_vercel_pat_here

# Optional: Redis for caching (performance boost)
# Use Vercel KV (Upstash Redis) credentials via `vercel env pull .env.development.local`
KV_REST_API_URL=https://your-upstash-url.upstash.io
KV_REST_API_TOKEN=your-upstash-token
# Legacy Upstash aliases remain supported for local overrides
UPSTASH_REDIS_REST_URL=https://your-upstash-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# Cache backend configuration (default in-memory; set to redis to enable appCache-backed unified cache)
# CACHE_BACKEND=redis
# APP_CACHE_UNIFIED_CACHE=true

# Optional generated game-catalog location
TACTICUS_GAME_FILES_PATH=

# Optional security-gate fixture overrides (tests and local verification only)
# ASSET_GATE_DOCKERFILE_PATH=
# ASSET_GATE_DOCKERIGNORE_PATH=

# Optional: overrides the kubectl lookup in the edge-runtime ancestry check
# (LOCAL verification only). It skips the live-cluster read entirely, so the
# gate would report PASS against whatever tag you name. The check REFUSES it
# with a loud FAIL whenever $CI is set -- do not add it as a repo,
# organization or environment variable.
# EDGE_RUNTIME_LIVE_TAG=

# External API URLs (rarely need to change)
# NEXT_PUBLIC_TACTICUS_API_URL=https://api.tacticusgame.com/api/v1
# NEXT_PUBLIC_AVATAR_API_URL=https://ui-avatars.com/api

# ==========================================
# Self-Hosted Infrastructure (REQUIRED for self-hosted deployments)
# ==========================================
# Traffic splitting, if any, is handled by your load balancer
NEXT_PUBLIC_SELFHOSTED_URL=https://app.example.com
NEXT_PUBLIC_PRODUCTION_URL=https://tacticusanalytics.com

# CRITICAL: Enables internal cron scheduler (sync jobs won't run without this!)
SELF_HOSTED=true

# CRITICAL: OAuth callback URL - must match your public API hostname
# Without this, Discord/Google OAuth will fail with redirect errors
API_EXTERNAL_URL=https://api.example.com

# Site URL for auth redirects
SITE_URL=https://app.example.com

# ==========================================
# Self-Hosted Supabase (REQUIRED)
# ==========================================

# JWT Secret - MUST be at least 32 characters, shared across all Supabase services
# Generate: openssl rand -base64 32
JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long

# Database password for PostgreSQL
POSTGRES_PASSWORD=your-secure-postgres-password

# Supabase Service Role Key - has full database access (keep secret!)
# Get from: Supabase Dashboard > Settings > API > service_role key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Internal Supabase URL for server-side calls (must be an allowlisted host in .app-identity.json)
SUPABASE_INTERNAL_URL=http://supabase-kong:8000

# ==========================================
# Self-Hosted Cron & Background Jobs
# ==========================================

# Secret for authenticating cron job HTTP calls
# Generate: openssl rand -hex 32
CRON_SECRET=your-cron-secret

# Pipeline A raid-sync execution locks. Keep disabled until live DB
# execution_locks shape and production contention behavior are verified.
SYNC1_PIPELINE_A_EXECUTION_LOCKS_ENABLED=false

# ==========================================
# Discord Bot Integration (REQUIRED for Discord features)
# ==========================================

# Discord Bot Token - from Discord Developer Portal > Bot > Token
DISCORD_BOT_TOKEN=your-discord-bot-token

# Discord Public Key - for verifying webhook signatures
# From Discord Developer Portal > General Information > Public Key
DISCORD_PUBLIC_KEY=your-discord-public-key

# HMAC secret used to sign and verify /api/discord/charts/* URLs.
# The chart routes render per-guild data and are fetched by Discord's media
# proxy, which cannot present an interaction signature or any header - so the
# signature travels in the URL (`exp` + `sig` query params).
# REQUIRED: with this unset the chart routes answer 503 and command embeds are
# rendered without their chart image. It is never "optional but open".
# Generate: openssl rand -hex 32
DISCORD_CHART_URL_SECRET=your-discord-chart-url-secret

# ==========================================
# Server-side data synchronization
# ==========================================
LOKI_SCRAPER_USER_ID=your-loki-user-id
LOKI_SCRAPER_CLIENT_SECRET=your-loki-client-secret

# ==========================================
# Cloudflare Tunnel (CRITICAL - site goes down without this!)
# ==========================================
# Get from: Cloudflare Dashboard > Zero Trust > Networks > Tunnels > Configure
# This token authenticates the cloudflared container to your Cloudflare tunnel
CLOUDFLARE_TUNNEL_TOKEN=
# Optional internal readiness URL used by infrastructure health checks.
CLOUDFLARED_HEALTH_URL=

# Bearer secret protecting detailed and external dependency health endpoints.
HEALTH_CHECK_SECRET=

# ==========================================
# Cloudflare API (cache purge, DNS management)
# ==========================================
CF_API_TOKEN=
CF_ZONE_ID=

# ==========================================
# Database Resilience Configuration
# ==========================================
# Connection timeout in milliseconds (default: 10000 = 10s)
# DB_CONNECTION_TIMEOUT=10000

# Statement/query timeout in milliseconds (default: 30000 = 30s)
# DB_STATEMENT_TIMEOUT=30000

# Connection pool settings (Supabase manages these, for reference only)
# DB_POOL_MIN=2
# DB_POOL_MAX=10

SENTRY_AUTH_TOKEN=your_sentry_auth_token

# ==========================================
# Additional runtime and operational controls
# ==========================================
# These are optional unless the related subsystem is enabled. Keeping every
# source-consumed variable here makes configuration drift visible in CI.
ADMIN_EMAIL=
API_KEY_ISSUE_NOTIFICATION_LOOKBACK_DAYS=7
API_KEY_ISSUE_NOTIFICATION_MAX_GUILDS=25
APP_URL=http://localhost:3000
BACKUP_LAST_SUCCESS=
BACKUP_MARKER_PATH=
BACKUP_STATUS_URL=
CIRCUIT_BREAKER_WEBHOOK_URL=
CONTAINER_MEMORY_LIMIT_MB=
CRON_PRIMARY_URL=
CRON_ROLE=
DATA_PATH=
# `self-hosted` turns on the Docker, disk, nginx, tunnel and PostgREST probes and the extreme-memory auto-shutdown.
DEPLOYMENT_ENV=development
# Optional comma-separated IPv4 CIDRs; a Supabase URL host inside one counts as self-hosted.
INTERNAL_NETWORK_CIDR=
DEPLOYMENT_MODE=local
DISCORD_DEV_WEBHOOK_ID=
DISCORD_GUILD_WEBHOOK_ID=
DISCORD_VERSION_WEBHOOK_ID=
DISCORD_WEBHOOKS_ENABLED=false
ENABLE_ADMIN_PRIVILEGE_ALERTS=false
ENABLE_PROCESS_RESTART_ALERTS=false
ENABLE_RUNTIME_PATCH=false
ENCRYPTION_KEY_PREVIOUS=
HEALTH_CACHE_TTL_MS=30000
HEALTH_REQUIRED_DOCKER_CONTAINERS=
IMPORT_MAP_PATH=
LOG_LEVEL=info
META_ATLAS_API_KEYS=
MONITORING_ALERT_EMAIL=
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_AUTH_RESET_VERSION=
NEXT_PUBLIC_BUILD_SHA=
NEXT_PUBLIC_DATAMINE_AVATAR_SPRITE_BASE_URL=
NEXT_PUBLIC_DEBUG=false
NEXT_PUBLIC_DEPLOYMENT=development
NEXT_PUBLIC_DISCORD_APPLICATION_ID=
DISCORD_APPLICATION_ID=YOUR_DISCORD_APPLICATION_ID
NEXT_PUBLIC_DOMAIN=http://localhost:3000
NEXT_PUBLIC_ENABLE_ANALYTICS=false
NEXT_PUBLIC_ENABLE_BOSS_ASSIGNMENTS=false
NEXT_PUBLIC_ENABLE_ERROR_REPORTING=false
NEXT_PUBLIC_ENABLE_GUILD_WAR=false
NEXT_PUBLIC_ENABLE_HOME_RPC=true
NEXT_PUBLIC_ENABLE_META_ANALYSIS_RPC=true
NEXT_PUBLIC_ENABLE_PLAYER_STATS_RPC=true
NEXT_PUBLIC_ENABLE_TOKEN_USAGE_RPC=true
NEXT_PUBLIC_ERROR_VOICE=off
NEXT_PUBLIC_LOG_MAX_REPEATS=5
NEXT_PUBLIC_SELFHOST_SANDBOX_MODE=false
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
NEXT_PUBLIC_VOTLW_STRICT_TOKENS=false
ONBOARDING_ALLOW_LEGACY_FALLBACK=false
ONBOARDING_JOB_BATCH_SIZE=25
ONBOARDING_PROCESS_JOBS_INLINE=false
ONBOARDING_USE_EDGE_FUNCTION=false
ONBOARDING_WORKER_TOKEN=
# Pod identity for work_queue.claimed_by. Optional: set via the k8s
# downward API (fieldRef: metadata.name); falls back to os.hostname() when unset.
POD_NAME=
REDIS_URL=redis://localhost:6379
RESEND_FROM_EMAIL=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_URL=https://sentry.io
SKIP_TYPECHECK_IN_DOCKER=false
STANDALONE_BUILD=false
SUPABASE_ANON_KEY=
SUPABASE_URL=http://localhost:54321
WI6060_ENHANCED_DATA_BACKEND=
WI6060_SEASON_DATA_BACKEND=
# Optional webhook endpoints
DISCORD_WEBHOOK_URL=
DISCORD_CLUSTER_APPLICATION_WEBHOOK_URL=
DISCORD_VERSION_WEBHOOK_URL=

# Optional local tooling and UI flags
GITHUB_TOKEN=
NEXT_PUBLIC_ENABLE_ENHANCED_SPINNERS=true
NEXT_PUBLIC_ENABLE_FLEXIBLE_TOKENS=true
NEXT_PUBLIC_ENABLE_LOKI=false
NEXT_PUBLIC_ENABLE_RESUME_REGISTRATION=false
NEXT_PUBLIC_ENABLE_TOOLTIPS=true
DISABLE_DIAGNOSTIC_MESSAGES=false

# Local path to the known-identities list for scripts/security/check-real-identities.mjs (never commit it).
# TA_KNOWN_IDENTITIES_FILE=

# Deployment profile defaults to hosted. Desktop requires explicit loopback service URLs.
NEXT_PUBLIC_RUNTIME_PROFILE=hosted
# Desktop coordinator generates this private per-launch value; never expose it as NEXT_PUBLIC.
# DESKTOP_TRANSPORT_KEY=
# Absolute path to a config.json (see apps/desktop/proof-readme.md) supplying real native
# PostgreSQL/Auth/PostgREST binaries and a staged standalone build for `npm run desktop:proof`
# gates (b)/(c); unset, those gates report skipped rather than running.
# DESKTOP_PROOF_CONFIG=
# Internal inherited descriptor set by the bundled Linux runtime guard.
# Leave unset; the launcher owns the kernel lease and supplies this value.
# DESKTOP_KERNEL_LEASE=
# Inherited from the graphical login session; do not set for hosted services.
# DBUS_SESSION_BUS_ADDRESS=

{
  "name": "tacticus-analytics",
  "version": "1.41.31",
  "private": true,
  "packageManager": "npm@10.9.7",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.22.2 <23"
  },
  "scripts": {
    "app:identity:check": "node scripts/dev/verify-app-identity.mjs",
    "app:identity:test": "node --test scripts/dev/verify-app-identity.test.mjs",
    "prepare": "husky",
    "predev": "npm run app:identity:check",
    "dev": "next dev --port 3000",
    "predev:turbo": "npm run app:identity:check",
    "dev:turbo": "next dev --turbo",
    "prebuild": "npm run app:identity:check",
    "build": "next build",
    "prestart": "npm run app:identity:check",
    "start": "next start",
    "lint": "eslint . --cache --cache-strategy content",
    "lint:fix": "eslint . --fix",
    "lint:actions": "actionlint -config-file .github/actionlint.yaml .github/workflows/*.yml && zizmor --config zizmor.yml .github/workflows",
    "lint:sql": "node scripts/dev/lint-sql.mjs 'supabase/migrations/**/*.sql'",
    "lint:sql:test": "node --test scripts/dev/lint-sql.test.mjs",
    "migrations:lint": "node scripts/dev/check-migrations.mjs",
    "rpc:catalog:check": "node scripts/dev/check-rpc-catalog.mjs",
    "rpc:catalog:selftest": "node scripts/dev/check-rpc-catalog.mjs --selftest",
    "migrations:lint:test": "node --test scripts/dev/check-migrations.test.mjs",
    "env:check": "node scripts/dev/check-env-contract.mjs",
    "lint:edge-imports": "node scripts/dev/check-edge-imports.mjs",
    "lint:edge-imports:test": "node --test scripts/dev/check-edge-imports.test.mjs",
    "gen:edge-solver": "node scripts/gen-edge-solver.mjs",
    "loki:season-lineups": "node scripts/loki/merge-season-lineups.cjs",
    "loki:season-lineups:check": "node scripts/loki/merge-season-lineups.cjs --check",
    "tooling:check": "npm run app:identity:check && npm run app:identity:test && npm run env:check && npm run lint:edge-imports:test && npm run lint:edge-imports && npm run lint:sql:test && npm run lint:sql && npm run migrations:lint:test && npm run migrations:lint && npm run rpc:catalog:selftest && npm run rpc:catalog:check && npm run loki:season-lineups:check && npm run edge:manifests:check && npm run edge:ancestry:check && npm run host:drift-check:selftest && npm run jobs:handler-coverage:check && npm run runner:standby-check",
    "typecheck": "tsc --noEmit",
    "typecheck:strict": "tsc --noEmit -p tsconfig.strict.json",
    "typecheck:scripts": "tsc --noEmit -p tsconfig.scripts.json",
    "typecheck:tests": "node scripts/validation/check-test-typecheck-ratchet.mjs --selftest && node scripts/validation/check-test-typecheck-ratchet.mjs",
    "typecheck:edge": "cd supabase/functions && for entry in */index.ts; do deno check --no-config \"$entry\" || exit 1; done",
    "test": "vitest run",
    "test:e2e:signin": "playwright test tests/e2e/auth-form-login.spec.ts",
    "test:pgtap:controls": "bash scripts/dev/pgtap-negative-controls.sh",
    "test:pgtap": "bash scripts/dev/pgtap-throwaway.sh --roster supabase/tests/pgtap/suites.txt",
    "test:integration:replay": "bash scripts/dev/integration-replay-stack.sh",
    "test:edge": "deno test --no-config --allow-env --allow-read --allow-write supabase/functions",
    "test:watch": "vitest",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "knip": "knip",
    "knip:exports:ratchet": "node scripts/dev/check-unused-exports-ratchet.mjs --selftest && node scripts/dev/check-unused-exports-ratchet.mjs --check",
    "supabase:start": "node scripts/dev/supabase-cli.mjs start",
    "supabase:stop": "node scripts/dev/supabase-cli.mjs stop",
    "supabase:status": "node scripts/dev/supabase-cli.mjs status",
    "supabase:reset": "node scripts/dev/supabase-cli.mjs db reset",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "security:check": "tsx scripts/security/check-secrets.ts",
    "security:cron-routes-guarded": "node scripts/validation/check-cron-routes-guarded.mjs --selftest && node scripts/validation/check-cron-routes-guarded.mjs --scan",
    "governance:retirement-check": "node scripts/governance/check-retirement-registry.mjs",
    "security:codeql:check": "node scripts/security/check-codeql-sarif.mjs codeql-results",
    "security:public-client-secret-intake": "node scripts/security/check-client-secret-intake-public.mjs --selftest && node scripts/security/check-client-secret-intake-public.mjs --scan",
    "security:null-skippable-auth-guards": "node scripts/security/check-null-skippable-auth-guards.mjs --selftest && node scripts/security/check-null-skippable-auth-guards.mjs --scan",
    "security:anon-definer-ratchet": "node scripts/security/anon-definer-census.mjs --selftest && node scripts/security/anon-definer-census.mjs --check",
    "security:anon-definer-census": "node scripts/security/anon-definer-census.mjs --census",
    "security:public-snapshot-scope": "node scripts/security/check-public-snapshot-scope.mjs --selftest && node scripts/security/check-public-snapshot-scope.mjs --scan",
    "security:gitleaks": "bash scripts/security/check-gitleaks.sh --selftest && bash scripts/security/check-gitleaks.sh --scan",
    "security:clean-repo": "node scripts/security/check-clean-repo.mjs --selftest && node scripts/security/check-clean-repo.mjs --scan && npm run security:asset-inventory && npm run security:public-snapshot-scope && npm run security:public-client-secret-intake && npm run security:null-skippable-auth-guards && npm run security:anon-definer-ratchet && tsx scripts/security/check-secrets.ts --selftest && npm run security:check && npm run security:docker-config-isolation && npm run security:image-cve-scan && npm run security:cron-routes-guarded && npm run security:gitleaks && npm run security:admin-route-guards && npm run security:authenticated-write-census && npm run security:comment-hygiene",
    "security:comment-hygiene": "node scripts/security/check-comment-hygiene.mjs --selftest && node scripts/security/check-comment-hygiene.mjs --scan",
    "security:real-identities": "node scripts/security/check-real-identities.mjs --selftest && node scripts/security/check-real-identities.mjs --scan",
    "security:admin-route-guards": "node scripts/security/check-admin-route-guards.mjs --selftest && node scripts/security/check-admin-route-guards.mjs --scan",
    "security:authenticated-write-census": "node scripts/security/check-authenticated-write-census.mjs --selftest && node scripts/security/check-authenticated-write-census.mjs --scan",
    "security:admin-route-census": "node scripts/security/check-admin-route-guards.mjs --census",
    "security:asset-inventory": "node scripts/security/check-asset-inventory.mjs",
    "security:asset-publication": "node scripts/security/check-asset-inventory.mjs --publication",
    "security:runtime-pii-assets": "node scripts/security/check-asset-inventory.mjs --runtime-pii",
    "security:docker-config-isolation": "node scripts/security/check-docker-config-isolation.mjs --selftest && node scripts/security/check-docker-config-isolation.mjs --scan",
    "security:image-cve-scan": "node scripts/security/check-image-cve-scan.mjs --selftest && node scripts/security/check-image-cve-scan.mjs --scan",
    "snapshot:verify": "sh scripts/security/verify-snapshot-clean.sh",
    "snapshot:verify:fast": "sh scripts/security/verify-snapshot-clean.sh --skip-build",
    "import:war-meta:tacticus-xyz": "tsx scripts/import/tacticus-xyz-war-meta.ts",
    "edge:manifests:check": "bash scripts/release/render-edge-manifests.sh --selftest",
    "edge:ancestry:check": "bash scripts/release/check-edge-image-ancestry.sh --selftest",
    "host:drift-check:selftest": "bash deploy/host/deploy-drift-check.sh --selftest",
    "jobs:handler-coverage:check": "node scripts/validation/check-handler-coverage.mjs",
    "runner:standby-check": "node scripts/dev/check-standby-runner-labels.mjs --selftest && node scripts/dev/check-standby-runner-labels.mjs --scan"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix"
    ],
    "*.{js,jsx,ts,tsx,md}": [
      "prettier --write"
    ],
    "!(*package-lock).json": [
      "prettier --write"
    ],
    "*.{css,yaml,yml}": [
      "prettier --write"
    ],
    "*.{ts,tsx,js,jsx,mjs,cjs,sql,sh,yml,yaml}": [
      "node scripts/security/check-comment-hygiene.mjs --files"
    ],
    "*": [
      "node scripts/security/check-real-identities.mjs --optional --files"
    ]
  },
  "overrides": {
    "next": {
      "postcss": "8.5.25"
    },
    "recharts": {
      "@types/react": "^18.0.0"
    },
    "tsx": {
      "esbuild": "0.25.12"
    },
    "linkify-it": "5.0.2",
    "sharp": "^0.35.3",
    "test-exclude": {
      "glob": "13.0.6"
    },
    "fast-uri": "3.1.6"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@sentry/core": "10.70.0",
    "@sentry/nextjs": "10.70.0",
    "@sentry/node": "10.70.0",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.90.1",
    "@tanstack/react-query": "^5.90.7",
    "@tanstack/react-query-devtools": "^5.90.2",
    "@types/node": "^24.10.1",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@upstash/redis": "^1.35.5",
    "clsx": "^2.1.1",
    "discord-api-types": "^0.38.45",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "ioredis": "^6.0.0",
    "lucide-react": "^0.555.0",
    "next": "16.3.5",
    "node-addon-api": "^8.8.0",
    "node-gyp": "^13.0.2",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "prom-client": "^15.1.3",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "react-is": "^19.2.4",
    "react-markdown": "^10.1.0",
    "recharts": "^3.6.0",
    "remark-gfm": "^4.0.1",
    "resend": "6.12.3",
    "sharp": "^0.35.3",
    "tailwind-merge": "^3.3.1",
    "typescript": "^5.0.0",
    "uuid": "^14.0.2",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.1",
    "@storybook/addon-a11y": "^10.4.0",
    "@storybook/addon-docs": "^10.4.0",
    "@storybook/addon-vitest": "^10.4.0",
    "@storybook/react-vite": "^10.5.8",
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/typography": "^0.5.19",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.3",
    "@typescript-eslint/parser": "^8.67.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/ui": "^5.0.2",
    "autoprefixer": "^10.4.21",
    "critters": "^0.0.23",
    "dotenv": "^18.0.4",
    "esbuild": "^0.25.12",
    "eslint": "^9.39.1",
    "eslint-config-next": "16.3.5",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-storybook": "^10.4.0",
    "glob": "^13.0.0",
    "happy-dom": "^20.0.10",
    "husky": "^9.1.7",
    "knip": "^6.32.2",
    "lint-staged": "^17.6.0",
    "prettier": "^3.6.2",
    "storybook": "^10.4.0",
    "supabase": "^2.72.8",
    "tailwindcss": "^3.4.19",
    "tailwindcss-debug-screens": "^2.2.1",
    "tsx": "^4.20.6",
    "vite": "^8.3.1",
    "vitest": "^5.0.2",
    "webpack": "^5.109.2",
    "yaml": "^2.8.4"
  }
}

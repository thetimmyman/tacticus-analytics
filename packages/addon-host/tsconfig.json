{
  "compilerOptions": {
    "target": "ES2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "types": ["node"]
  },
  "include": [
    "src/**/*.ts",
    "../../apps/addons/**/*.ts",
    "../../apps/addons/**/*.tsx",
    "../../tests/addons/**/*.ts",
    "../../tests/addons/**/*.tsx"
  ]
}
